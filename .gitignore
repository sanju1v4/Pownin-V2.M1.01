# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
# The Expo template only ignores .env*.local, which would have committed the
# OPENAI_API_KEY sitting in .env. Ignore the secret itself.
.env
.env.*
!.env.example

# python
__pycache__/
*.py[cod]
.venv/
venv/

# audio: demo inputs and regenerable outputs, ~38 MB. server.py and enhance.py
# reproduce them; keeping them out keeps clones fast.
*.wav
*.m4a
*.webm
bench_data/
served/

# upstream model repo, cloned separately -- it carries its own .git, so adding
# it here would leave a broken gitlink rather than real files.
DPDFNet/

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
